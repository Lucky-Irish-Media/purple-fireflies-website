# Generate a secret key: openssl rand -base64 32
SESSION_SECRET=your_secret_key_here

# Email (Resend-compatible API — https://resend.com)
# Get your API key from https://resend.com/api-keys
EMAIL_API_KEY=re_your_api_key_here
EMAIL_FROM=Mel <mel@purplefireflies.org>
# EMAIL_API_URL=https://api.resend.com/emails

# Springfield Neighbors — running total of boxes delivered, shown in the hero stats
# strip on /programs/springfield-neighbors. Manually bumped (or set the Worker var
# in wrangler.toml). Any value that isn't a non-negative integer renders as 0.
SPRINGFIELD_BOXES_DELIVERED=95
