# Generate a secret key: openssl rand -base64 32
SESSION_SECRET=your_secret_key_here

# Email (Resend-compatible API — https://resend.com)
# Get your API key from https://resend.com/api-keys
EMAIL_API_KEY=re_your_api_key_here
EMAIL_FROM=Mel <mel@purplefireflies.org>
# EMAIL_API_URL=https://api.resend.com/emails

# Springfield Neighbors — running total of boxes delivered, shown in the hero stats
# strip on /programs/springfield-neighbors. Manually bumped (or set the Worker var
# in wrangler.toml). Any value that isn't a non-negative integer renders as 0.
SPRINGFIELD_BOXES_DELIVERED=95

# Community Pet Fund - Givebutter
# API key: Givebutter dashboard > Settings > API. Powers the admin "Refresh from
# Givebutter" button, which copies campaign totals into D1.
GIVEBUTTER_API_KEY=your_givebutter_api_key_here
# Webhook signing secret: Givebutter dashboard > Webhooks. Givebutter sends this
# value verbatim in a `Signature` header on every delivery.
GIVEBUTTER_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Internal alerts (Givebutter plan failures). Falls back to
# info@purplefireflies.org when unset.
# ADMIN_EMAIL=info@purplefireflies.org
